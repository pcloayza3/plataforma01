<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mono_container"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_gravity="center"
    android:background="@drawable/widget_postit_bg"
    android:padding="4dp">

    <!-- Ícono nítido de UnLethe para AOD sin oscurecer ni pintar en blanco sólido -->
    <ImageView
        android:id="@+id/widget_mono_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="UnLethe AOD Widget" />

    <!-- Badge de alerta -->
    <TextView
        android:id="@+id/widget_mono_count"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_badge"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
