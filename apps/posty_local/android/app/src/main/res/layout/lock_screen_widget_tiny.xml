<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tiny_container"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_gravity="center">

    <!-- Ícono de la Nota UnLethe en Pantalla de Bloqueo -->
    <ImageView
        android:id="@+id/widget_tiny_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="UnLethe Widget" />

    <!-- Contador / Badge de Notas Urgentes Pendientes -->
    <TextView
        android:id="@+id/widget_tiny_count"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_badge"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
